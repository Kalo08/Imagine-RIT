# Target: ESP32-P4 (Waveshare ESP32-P4-NANO). ESP-IDF >= 5.4 required.
CONFIG_IDF_TARGET="esp32p4"

# --- Real-time scheduling: 1 kHz tick so vTaskDelayUntil gives an exact 5 ms (200 Hz) loop
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_UNICORE=n
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=2

# --- 32 MB PSRAM for camera frames / LVGL buffers
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# --- USB 2.0 High-Speed device (TinyUSB), two CDC-ACM ports: 0 = protocol, 1 = reserved/log
CONFIG_TINYUSB_RHPORT_HS=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=2048
CONFIG_TINYUSB_CDC_TX_BUFSIZE=16384

# --- Console on the UART so USB is dedicated to the Pi link
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# --- LVGL
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_FLOAT=y
